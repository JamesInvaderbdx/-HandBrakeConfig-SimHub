<UserControl x:Class="HandBrakeConfig.UI.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#021f2d" Foreground="#f0f0f0"
             FontFamily="Courier New" HorizontalAlignment="Stretch">

    <UserControl.Resources>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4fc3f7"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize"   Value="15"/>
            <Setter Property="FontFamily" Value="Courier New"/>
            <Setter Property="Margin"     Value="0,16,0,8"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="#aaaaaa"/>
            <Setter Property="FontSize"          Value="15"/>
            <Setter Property="FontFamily"        Value="Courier New"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="#031828"/>
            <Setter Property="Foreground"      Value="#f0f0f0"/>
            <Setter Property="BorderBrush"     Value="#b44fd4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="6,4"/>
            <Setter Property="FontFamily"      Value="Courier New"/>
            <Setter Property="FontSize"        Value="15"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background"      Value="#031828"/>
            <Setter Property="Foreground"      Value="#f0f0f0"/>
            <Setter Property="BorderBrush"     Value="#b44fd4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="FontFamily"      Value="Courier New"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#031828"/>
                        <Setter Property="Foreground" Value="#f0f0f0"/>
                        <Setter Property="FontFamily" Value="Courier New"/>
                        <Setter Property="FontSize"   Value="14"/>
                        <Setter Property="Padding"    Value="6,4"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0d3d57"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#b44fd4"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#b44fd4"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#aaaaaa"/>
            <Setter Property="FontFamily" Value="Courier New"/>
            <Setter Property="FontSize"   Value="15"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"      Value="#e91e8c"/>
            <Setter Property="Foreground"      Value="#f0f0f0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontFamily"      Value="Courier New"/>
            <Setter Property="FontSize"        Value="15"/>
            <Setter Property="FontWeight"      Value="Bold"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background"      Value="#0a2d40"/>
            <Setter Property="Foreground"      Value="#4fc3f7"/>
            <Setter Property="BorderBrush"     Value="#4fc3f7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontFamily"      Value="Courier New"/>
            <Setter Property="FontSize"        Value="14"/>
        </Style>

        <Style x:Key="CalButton" TargetType="Button">
            <Setter Property="Background"      Value="#b44fd4"/>
            <Setter Property="Foreground"      Value="#f0f0f0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontFamily"      Value="Courier New"/>
            <Setter Property="FontSize"        Value="15"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="#0a2d40"/>
            <Setter Property="BorderBrush"     Value="#0d3d57"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="0"/>
            <Setter Property="Padding"         Value="14,12"/>
            <Setter Property="Margin"          Value="0,0,0,2"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#021f2d">
        <StackPanel Margin="14,12,14,16">

            <!-- HEADER -->
            <Border Background="#031828" BorderBrush="#b44fd4"
                    BorderThickness="0,0,0,2" Padding="12,12,12,14" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="eKLID " FontSize="13" FontWeight="Bold" Foreground="#b44fd4"/>
                            <TextBlock Text="PiXL "  FontSize="13" FontWeight="Bold" Foreground="#e91e8c"/>
                            <TextBlock Text="PRODUCTION" FontSize="11" Foreground="#aaaaaa" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <TextBlock Text="HANDBRAKE CONFIG" FontSize="26" FontWeight="Bold"
                                   Foreground="#f0f0f0" Margin="0,0,0,4"/>
                        <TextBlock Text="calibration  //  dead zone  //  response curve"
                                   FontSize="12" Foreground="#4fc3f7" Margin="0,0,0,8"/>
                        <TextBlock FontSize="12">
                            <Hyperlink NavigateUri="https://ko-fi.com/VOTRE_PSEUDO"
                                       RequestNavigate="Hyperlink_Navigate"
                                       Foreground="#e91e8c">
                                buy me a coffee
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <Image Grid.Column="1"
                           Source="pack://application:,,,/HandBrakeConfig;component/handbrake_logo.png"
                           Width="80" Height="95"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Border>

            <!-- LIVE PREVIEW -->
            <TextBlock Text="// LIVE PREVIEW" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="65"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="22"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="raw"
                               Foreground="#555566" FontSize="12" VerticalAlignment="Center"/>
                    <ProgressBar Grid.Row="0" Grid.Column="1" x:Name="PbRaw"
                                 Height="10" Background="#031828" Foreground="#0d3d57"
                                 BorderThickness="0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" x:Name="TbRaw"
                               Text="0%" Foreground="#555566" FontSize="12"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="output"
                               Foreground="#4fc3f7" FontSize="12" VerticalAlignment="Center"/>
                    <ProgressBar Grid.Row="2" Grid.Column="1" x:Name="PbOut"
                                 Height="14" Background="#031828" Foreground="#e91e8c"
                                 BorderThickness="0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="TbOut"
                               Text="0%" Foreground="#e91e8c" FontSize="13" FontWeight="Bold"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- INPUT MODE -->
            <TextBlock Text="// INPUT MODE" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <!-- Mode selector -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="RbHID"    Content="HID joystick"
                                     GroupName="InputMode" Margin="0,0,24,0"
                                     Checked="InputMode_Changed"/>
                        <RadioButton x:Name="RbSerial" Content="Arduino Nano (serial)"
                                     GroupName="InputMode"
                                     Checked="InputMode_Changed"/>
                    </StackPanel>

                    <!-- HID panel -->
                    <StackPanel x:Name="PanelHID">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="85"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="38"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="device" Style="{StaticResource Label}"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="CbDevice"
                                       SelectionChanged="CbDevice_SelectionChanged"/>
                            <Button    Grid.Row="0" Grid.Column="2" Content="refresh"
                                       Style="{StaticResource SecondaryButton}"
                                       Margin="6,0,0,0" Click="BtnRefresh_Click"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="axis" Style="{StaticResource Label}"/>
                            <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="CbAxis"
                                       SelectionChanged="CbAxis_SelectionChanged"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="TbAxisLive"
                                       Text="---" Foreground="#b44fd4" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- Serial panel -->
                    <StackPanel x:Name="PanelSerial" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="85"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="38"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="port" Style="{StaticResource Label}"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="CbSerialPort"
                                       SelectionChanged="CbSerialPort_SelectionChanged"/>
                            <Button    Grid.Row="0" Grid.Column="2" Content="refresh"
                                       Style="{StaticResource SecondaryButton}"
                                       Margin="6,0,0,0" Click="BtnSerialRefresh_Click"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="axis" Style="{StaticResource Label}"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="RbSerialX" Content="X  (A1)"
                                             GroupName="SerialAxis" Margin="0,0,20,0"
                                             Checked="SerialAxis_Changed"/>
                                <RadioButton x:Name="RbSerialY" Content="Y  (A2)"
                                             GroupName="SerialAxis"
                                             Checked="SerialAxis_Changed"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="TbSerialStatus"
                                       Text="---" Foreground="#b44fd4" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- CALIBRATION -->
            <TextBlock Text="// CALIBRATION" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="min" Style="{StaticResource Label}" Width="35"/>
                        <TextBox x:Name="TbMin" Width="80"/>
                        <TextBlock Text="max" Style="{StaticResource Label}" Width="35" Margin="12,0,0,0"/>
                        <TextBox x:Name="TbMax" Width="80"/>
                        <Button Content="apply" Style="{StaticResource SecondaryButton}"
                                Margin="10,0,0,0" Click="BtnApplyManual_Click"/>
                    </StackPanel>
                    <CheckBox x:Name="CbInvert" Content="inverser l'axe"
                              Foreground="#e91e8c" FontFamily="Courier New" FontSize="14"
                              Margin="0,0,0,10" Checked="CbInvert_Changed" Unchecked="CbInvert_Changed"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnCal" Content="start auto calibration"
                                Style="{StaticResource CalButton}"
                                Click="BtnCal_Click" Width="190"/>
                        <TextBlock x:Name="TbCalStatus"
                                   Text="  pull and release fully"
                                   Foreground="#555566" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- DEAD ZONE -->
            <TextBlock Text="// DEAD ZONE" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="28"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="bottom (released)" Style="{StaticResource Label}"/>
                    <Slider    Grid.Row="0" Grid.Column="1" x:Name="SlDzLow"
                               Minimum="0" Maximum="20" SmallChange="0.5"
                               ValueChanged="SlDzLow_Changed" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" x:Name="TbDzLowVal"
                               Text="3.0%" Foreground="#b44fd4" FontSize="13"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="top (full pull)" Style="{StaticResource Label}"/>
                    <Slider    Grid.Row="2" Grid.Column="1" x:Name="SlDzHigh"
                               Minimum="0" Maximum="20" SmallChange="0.5"
                               ValueChanged="SlDzHigh_Changed" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="TbDzHighVal"
                               Text="2.0%" Foreground="#b44fd4" FontSize="13"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- VJOY OUTPUT -->
            <TextBlock Text="// vJOY OUTPUT" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="CbVJoy" Content="activer la sortie vJoy (Device 2 / Axe Y)"
                              Foreground="#4fc3f7" FontFamily="Courier New" FontSize="14"
                              Checked="CbVJoy_Changed" Unchecked="CbVJoy_Changed"/>
                    <TextBlock x:Name="TbVJoyStatus" Text=""
                               Foreground="#b44fd4" FontSize="12" FontFamily="Courier New"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- RESPONSE CURVE -->
            <TextBlock Text="// RESPONSE CURVE" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="RbLinear"  Content="linear"
                                     Margin="0,0,22,0" Checked="Curve_Changed"/>
                        <RadioButton x:Name="RbExpo"    Content="exponential"
                                     Margin="0,0,22,0" Checked="Curve_Changed"/>
                        <RadioButton x:Name="RbScurve"  Content="s-curve"
                                     Checked="Curve_Changed"/>
                    </StackPanel>
                    <StackPanel x:Name="PanelExpo" Orientation="Horizontal">
                        <TextBlock Text="exponent" Style="{StaticResource Label}" Width="80"/>
                        <Slider x:Name="SlExpo" Minimum="1" Maximum="4" SmallChange="0.1"
                                Width="180" ValueChanged="SlExpo_Changed" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TbExpo" Text="2.0" Foreground="#b44fd4"
                                   FontSize="13" Margin="10,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- IN-GAME SETUP -->
            <TextBlock Text="// IN-GAME SETUP (vJoy)" Style="{StaticResource SectionLabel}"/>
            <Border Background="#031828" BorderBrush="#e91e8c"
                    BorderThickness="2,0,0,0" Padding="14,12" Margin="0,0,0,2">
                <StackPanel>
                    <TextBlock Foreground="#e91e8c" FontSize="13" FontWeight="Bold"
                               Text="requires vJoy driver" Margin="0,0,0,8"/>
                    <TextBlock Foreground="#aaaaaa" FontSize="12" Margin="0,0,0,4"
                               Text="[1]  install vJoy — vjoystick.sourceforge.net"/>
                    <TextBlock Foreground="#aaaaaa" FontSize="12" Margin="0,0,0,4"
                               Text="[2]  configure Device 2 with Y axis"/>
                    <TextBlock Foreground="#aaaaaa" FontSize="12" Margin="0,0,0,4"
                               Text="[3]  SimHub > vJoy > map HandBrake.Output"/>
                    <TextBlock Foreground="#aaaaaa" FontSize="12" Margin="0,0,0,10"
                               Text="     to Device 2 / Axis Y"/>
                    <TextBlock Foreground="#4fc3f7" FontSize="12" TextWrapping="Wrap"
                               Text="SimHub properties :  HandBrake.Output [0-1]  |  HandBrake.OutputPercent [0-100]"/>
                </StackPanel>
            </Border>

            <!-- ACTIONS -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="SAVE CONFIG" Style="{StaticResource PrimaryButton}"
                        Click="BtnSave_Click" Width="160"/>
                <Button Content="reset defaults" Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0" Click="BtnReset_Click" Width="140"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
